# Server
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
BOT_NAME="AI Tech News Bot"
BOT_TOPIC="AI technology news"
BOT_DAILY_MESSAGE_LIMIT=5
BOT_REPLY_COOLDOWN_SECONDS=30

# Instagram / Meta Messenger API for Instagram
INSTAGRAM_VERIFY_TOKEN=replace-with-a-random-token
INSTAGRAM_PAGE_ACCESS_TOKEN=replace-with-meta-page-access-token
INSTAGRAM_APP_SECRET=replace-with-meta-app-secret

# TikTok
# TikTok DM access is restricted. Use credentials from an approved TikTok
# Business Messaging provider or your approved internal integration.
TIKTOK_WEBHOOK_SECRET=replace-with-provider-webhook-secret
TIKTOK_API_BASE_URL=https://provider.example/api
TIKTOK_ACCESS_TOKEN=replace-with-provider-access-token

# Twitter / X
TWITTER_API_BASE_URL=https://api.x.com
TWITTER_BEARER_TOKEN=replace-with-x-user-context-token
TWITTER_CONSUMER_SECRET=replace-with-x-consumer-secret-for-crc
